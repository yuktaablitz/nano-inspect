{
 "sop_id": "QA-SOP-NI-001",
 "version": "1.0",
 "effective": "2026-09-25",
 "owner": "Plant quality manager",
 "basis": "ISO 9001:2015 clause 8.7 (control of nonconforming outputs): identify, segregate, record, disposition by authorised staff.",
 "note": "Example SOP written for the MVTec AD demo products. In a plant this file is exported from the quality management system and version-controlled; NanoInspect never invents actions that are not in it.",
 "dispositions": {
  "critical": {
   "disposition": "reject",
   "line_command": "divert_to_reject_bin",
   "containment": {
    "stop_line_if_repeats": 3,
    "window_parts": 20,
    "recheck_last_n": 20,
    "notify": [
     "line supervisor",
     "quality engineer"
    ]
   },
   "ncr_required": true
  },
  "major": {
   "disposition": "reject",
   "line_command": "divert_to_reject_bin",
   "containment": {
    "stop_line_if_repeats": 5,
    "window_parts": 50,
    "recheck_last_n": 10,
    "notify": [
     "line supervisor"
    ]
   },
   "ncr_required": true
  },
  "minor": {
   "disposition": "hold_for_mrb",
   "line_command": "divert_to_hold_bin",
   "containment": {
    "stop_line_if_repeats": 10,
    "window_parts": 100,
    "recheck_last_n": 0,
    "notify": [
     "quality engineer"
    ]
   },
   "ncr_required": true
  }
 },
 "accept": {
  "disposition": "release",
  "line_command": "pass"
 },
 "manual_review": {
  "disposition": "hold_for_review",
  "line_command": "divert_to_hold_bin"
 },
 "products": {
  "bottle": {
   "station": "Bottle forming + filling",
   "defects": {
    "broken_large": {
     "severity": "critical",
     "likely_causes": [
      "mould damage",
      "handling impact at conveyor transfer"
     ],
     "process_check": "Inspect mould cavity and transfer star-wheel for chips",
     "rework_allowed": false
    },
    "broken_small": {
     "severity": "major",
     "likely_causes": [
      "mould wear",
      "annealing stress"
     ],
     "process_check": "Check annealing lehr temperature profile",
     "rework_allowed": false
    },
    "contamination": {
     "severity": "major",
     "likely_causes": [
      "foreign particles in filling line",
      "dirty mould"
     ],
     "process_check": "Flush filler nozzles; inspect mould cleanliness",
     "rework_allowed": false
    }
   }
  },
